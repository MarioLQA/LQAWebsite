---
import '../styles/global.css';

const year = new Date().getFullYear();

const t = {
  de: {
    nav: { about: 'Über mich', services: 'Leistungen', projects: 'Projekte', stack: 'Stack', contact: 'Kontakt' },
    about: {
      title: 'Über mich',
      para1: 'Eigentlich wollte ich Entwickler werden. In die IT bin ich über meine erste QA-Rolle gekommen und habe dort etwas gefunden, das ich nicht gesucht hatte: Ich schaue Software gern bis ins Detail an. Den Code schreibe ich in der Testautomatisierung.',
      para2: 'Ich freue mich über einen kniffligen Edge Case, den andere übersehen hätten. Und ich höre nicht auf, bevor klar ist, warum etwas fehlschlägt. Danach soll das Team wissen, was zu tun ist, ohne dass ich noch eine Runde erklären muss.',
      note: 'ISTQB-zertifizierter Test Analyst, Foundation und Advanced. Ich arbeite remote und vor Ort.',
    },
    hero: {
      kicker: 'Qualität ist kein Zufall.',
      sub: 'Ich arbeite als freiberuflicher QA-Engineer in agilen Teams, remote und vor Ort, aktuell bei BRZ an der Zollanwendung Customs Decision Austria.',
      cta: 'Schreiben Sie mir',
    },
    services: {
      title: 'Leistungen',
      card1: {
        title: 'Testanalyse und Teststrategie',
        desc: 'So läuft es bei BRZ. Customs Decision Austria hängt an EU-Systemen, die Vorgaben ändern sich. Ich lese sie, lege den Testumfang fest und stimme die Testphasen mit dem Testmanager ab.',
        link: 'Das BRZ-Projekt',
      },
      card2: {
        title: 'Testautomatisierung',
        desc: 'So war es bei REWE. Die Artikelverwaltung wechselte von JSF auf Angular, und ich habe die Automatisierung mit Cypress und Cucumber neu aufgebaut: von null auf rund 200 Testfälle, neue Features jeweils gleich mit.',
        link: 'Das REWE-Projekt',
      },
    },
    projects: {
      title: 'Projekte',
      sub: 'Zoll, Handel, Banken und ein Bauunternehmen.',
    },
    stack: {
      title: 'Tech Stack',
      sub: 'Womit ich arbeite.',
    },
    contact: {
      title: 'Kontakt',
      sub: 'Wenn Sie Unterstützung im Testen brauchen, schreiben Sie mir. Es reichen ein paar Sätze, worum es geht.',
      name: 'Name',
      email: 'E-Mail',
      message: 'Nachricht',
      send: 'Per E-Mail senden',
      linkedin: 'LinkedIn-Profil',
      emaillink: 'E-Mail schreiben',
    },
    footer: {
      tagline: 'Qualität ist kein Zufall.',
      legal: 'Impressum',
      privacy: 'Datenschutz',
    },
  },
  en: {
    nav: { about: 'About', services: 'Services', projects: 'Projects', stack: 'Stack', contact: 'Contact' },
    about: {
      title: 'About me',
      para1: 'I was going to be a developer. I got into IT through my first QA role and found something I hadn\'t been looking for: I like taking software apart in detail. I write the code in the test automation.',
      para2: 'I like a tricky edge case other people would have missed, and I don\'t stop until it\'s clear why something failed. After that, the team should know what to do without another round of explanation from me.',
      note: 'ISTQB-certified Test Analyst, Foundation and Advanced. I work remote and on-site.',
    },
    hero: {
      kicker: 'Quality is no coincidence.',
      sub: 'I work as a freelance QA engineer in agile teams, remote and on-site, currently at BRZ on Customs Decision Austria.',
      cta: 'Write to me',
    },
    services: {
      title: 'Services',
      card1: {
        title: 'Test analysis and test strategy',
        desc: 'This is the work at BRZ. Customs Decision Austria is tied to EU systems, and the requirements keep changing. I read them, set the test scope, and plan the test phases with the test manager.',
        link: 'The BRZ project',
      },
      card2: {
        title: 'Test automation',
        desc: 'This was the work at REWE. Product management moved from JSF to Angular, and I rebuilt the automation with Cypress and Cucumber: from zero to about 200 test cases, with each new feature covered as it shipped.',
