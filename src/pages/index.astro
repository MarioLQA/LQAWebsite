<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- DE Meta (default) -->
  <title>Mario Lirsch – Freelance QA Engineer | LQA Consulting</title>
  <meta name="description" content="Mario Lirsch, freiberuflicher QA-Engineer. Testanalyse und Testautomatisierung, aktuell bei BRZ an Customs Decision Austria." />
  <meta name="keywords" content="QA Consulting, Testautomatisierung, Teststrategie, Cypress, Selenium, Appium, ISTQB, Freelancer, Mario Lirsch" />

  <!-- EN Meta (in JSON-LD alternate) -->
  <link rel="alternate" hreflang="en" href="?lang=en" />
  <link rel="alternate" hreflang="de" href="?lang=de" />

  <!-- OG -->
  <meta property="og:title" content="Mario Lirsch – Freelance QA Engineer | LQA Consulting" />
  <meta property="og:description" content="Mario Lirsch, freiberuflicher QA-Engineer. Testanalyse und Testautomatisierung, aktuell bei BRZ an Customs Decision Austria." />
