<!-- ======== SCRIPTS ======== -->
<script define:vars={{ tDE: t.de, tEN: t.en }}>
  // ---- Translations ----
  const translations = { de: tDE, en: tEN };
  let currentLang = 'de';

  function getNestedValue(obj, key) {
    return key.split('.').reduce((o, k) => (o ? o[k] : undefined), obj);
  }

  function applyTranslations(lang) {
    const t = translations[lang];
    currentLang = lang;

    // Update html lang attr
    document.documentElement.lang = lang;

    // Text nodes
    document.querySelectorAll('[data-key]').forEach(el => {
      const val = getNestedValue(t, el.dataset.key);
      if (val) el.textContent = val;
    });

    // Placeholder text
    document.querySelectorAll('[data-placeholder-de]').forEach(el => {
      el.placeholder = el.dataset[`placeholder${lang.charAt(0).toUpperCase() + lang.slice(1)}`] || el.dataset.placeholderDe;
    });

    // Show/hide language-specific content (data-show-lang)
    document.querySelectorAll('[data-show-lang]').forEach(el => {
      el.classList.toggle('hidden', el.dataset.showLang !== lang);
    });

    // Update lang buttons
    document.querySelectorAll('#btn-de, #btn-de-m').forEach(b => b.classList.toggle('active', lang === 'de'));
    document.querySelectorAll('#btn-en, #btn-en-m').forEach(b => b.classList.toggle('active', lang === 'en'));

    // Update meta
    const metaDesc = document.querySelector('meta[name="description"]');
    if (lang === 'en' && metaDesc) {
      metaDesc.content = 'Mario Lirsch, freelance QA engineer. Test analysis and test automation, currently at BRZ on Customs Decision Austria.';
      document.title = 'Mario Lirsch – Freelance QA Engineer | LQA Consulting';
    } else if (metaDesc) {
      metaDesc.content = 'Mario Lirsch, freiberuflicher QA-Engineer. Testanalyse und Testautomatisierung, aktuell bei BRZ an Customs Decision Austria.';
      document.title = 'Mario Lirsch – Freelance QA Engineer | LQA Consulting';
    }
  }

  window.setLang = function(lang) {
    applyTranslations(lang);
    try { localStorage.setItem('lqa-lang', lang); } catch(e) {}
  };

  // ---- Nav scroll effect ----
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  // ---- Mobile menu ----
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });
  window.closeMobileMenu = function() {
    mobileMenu.classList.add('hidden');
  };

  // ---- Scroll reveal (individual elements + stagger parents) ----
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => observer.observe(el));

  // ---- ScrollSpy — highlight active nav link ----
  const spySections = ['about', 'services', 'projects', 'stack', 'contact'];
  const navLinks = document.querySelectorAll('.nav-link');
  function updateActiveNav() {
    const scrollY = window.scrollY + 120;
    let current = '';
    for (const id of spySections) {
      const el = document.getElementById(id);
      if (el && scrollY >= el.offsetTop) current = id;
    }
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      const isActive = href === `#${current}`;
      link.classList.toggle('active', isActive);
    });
  }
  window.addEventListener('scroll', updateActiveNav, { passive: true });

  // ---- Init language ----
  (function init() {
    let lang = 'de';
    try { lang = localStorage.getItem('lqa-lang') || 'de'; } catch(e) {}
    if (lang !== 'de') applyTranslations(lang);
  })();
</script>

