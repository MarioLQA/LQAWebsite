const projects = [
  {
    id: 'project-brz',
    industryDe: 'Öffentlicher Sektor',
    industryEn: 'Public sector',
    company: 'BRZ – Customs Decision Austria (CDA)',
    periodDe: 'Juli 2023 – Heute',
    periodEn: 'July 2023 – Present',
    textDe: 'In Customs Decision Austria stellen Unternehmen zollrechtliche Anträge, Sachbearbeiter bearbeiten sie. Die Anwendung ist Java/JSF, angebunden an EU-Systeme und an ein CRS für mehrere SOAP- und REST-Schnittstellen. Ich lese die Änderungen aus der EU, mache daraus Tests, koordiniere die Phasen mit dem Testmanager und begleite die Umstellung der Oberfläche auf Angular. Die Automatisierung umfasst rund 200 Testfälle in Java mit Selenium.',
    textEn: 'In Customs Decision Austria, businesses file customs applications and case workers process them. The application is Java/JSF, connected to EU systems and to a CRS for several SOAP and REST interfaces. I read the changes coming from the EU, turn them into tests, coordinate the phases with the test manager, and test through the move of the UI from JSF to Angular. The automation covers about 200 Java test cases on Selenium.',
    tagsDe: ['Java', 'Selenium', 'SOAP', 'REST', 'JSF', 'Angular'],
    tagsEn: ['Java', 'Selenium', 'SOAP', 'REST', 'JSF', 'Angular'],
  },
  {
    id: 'project-rewe',
    industryDe: 'Handel',
    industryEn: 'Retail',
    company: 'REWE IT',
    periodDe: 'Oktober 2022 – Juli 2023',
    periodEn: 'October 2022 – July 2023',
    textDe: 'Die Artikelverwaltung lief auf JSF und wurde durch eine Angular-Applikation ersetzt. Die Automatisierung habe ich dafür neu aufgebaut, mit Cypress und Cucumber, und neue Features direkt mit Tests abgedeckt. Von null auf rund 200 automatisierte Testfälle.',
    textEn: 'Product management ran on JSF and was replaced by an Angular app. I rebuilt the automation for that move with Cypress and Cucumber, and covered new features as they were built. From zero to about 200 automated test cases.',
    tagsDe: ['Cypress', 'Cucumber', 'Angular', 'JSF'],
    tagsEn: ['Cypress', 'Cucumber', 'Angular', 'JSF'],
  },
  {
    id: 'project-erste',
    industryDe: 'Banken',
    industryEn: 'Banking',
    company: 'Erste Group IT',
    periodDe: 'Mai 2021 – September 2022',
    periodEn: 'May 2021 – September 2022',
    textDe: 'Ich saß in einem Feature-Squad, die Regression lief in eigenen Teams daneben. Neue Features habe ich mit Cypress isoliert getestet: die API-Calls beim Laden abgefangen und durch Mocks ersetzt. Fertige Tests gingen an die Regression und liefen dort als End-to-End-Tests gegen die echten Systeme. Die Applikation gab es in fünf Ländern: Österreich, Kroatien, Slowakei, Rumänien und Tschechien, jeweils mit eigener Oberfläche.',
    textEn: 'I sat in a feature squad, with regression running in separate teams beside it. I tested new features in isolation with Cypress: intercepting the API calls on load and replacing them with mocks. Finished tests went to regression and ran there end to end against the real systems. The app was live in five countries: Austria, Croatia, Slovakia, Romania, and the Czech Republic, each with its own UI.',
    tagsDe: ['Cypress', 'React', 'API-Mocking', 'Cucumber', 'Postman'],
    tagsEn: ['Cypress', 'React', 'API mocking', 'Cucumber', 'Postman'],
  },
  {
    id: 'project-ing',
    industryDe: 'Banken',
    industryEn: 'Banking',
    company: 'ING Austria',
    periodDe: 'April 2019 – Mai 2021',
    periodEn: 'April 2019 – May 2021',
    textDe: 'Getestet habe ich vier Plattformen gleichzeitig: Online Banking, die App für iOS und Android und zwei interne Banksysteme. Die App wurde in Istanbul gebaut, die Abstimmung lief über Zeitzonen. Ich habe die vorhandene Automatisierung gepflegt und erweitert. Das waren über 1.000 Tests mit Selenium, Appium und Cucumber, an Jenkins angebunden und in Allure berichtet.',
    textEn: 'I tested four platforms at once: online banking, the iOS and Android app, and two internal banking systems. The app was built in Istanbul, so the coordination crossed time zones. I maintained and extended the automation the team already had: over 1,000 tests on Selenium, Appium, and Cucumber, run through Jenkins and reported in Allure.',
    tagsDe: ['Selenium', 'Appium', 'Cucumber', 'TestNG', 'Jenkins', 'Allure'],
    tagsEn: ['Selenium', 'Appium', 'Cucumber', 'TestNG', 'Jenkins', 'Allure'],
  },
  {
    id: 'project-huberbau',
    industryDe: 'Bau',
    industryEn: 'Construction',
    company: 'HuberBau',
    periodDe: 'Januar 2020 – Dezember 2020',
    periodEn: 'January 2020 – December 2020',
    textDe: 'Ich war der einzige Tester, neben zwei Entwicklern. Zusammen haben wir eine Angular-Applikation von Grund auf entwickelt: Personaldaten, Baustellen und Fotos direkt auf der Baustelle. Die Testfälle habe ich geschrieben, dazu ein Regressionsset mit rund 30–50 Fällen.',
    textEn: 'I was the only tester, next to two developers. Together we built an Angular app from scratch: staff data, construction sites, and photos taken on site. I wrote the test cases, including a regression set of about 30–50.',
    tagsDe: ['Manuelles Testen', 'Angular', 'Regression'],
    tagsEn: ['Manual testing', 'Angular', 'Regression'],
  },
];

const techStack = [
  'Cypress',
  'Selenium',
  'Appium',
  'Cucumber',
  'TestNG',
  'Java',
  'JS / TypeScript',
  'Postman',
  'Allure',
  'Jira / Confluence',
  'Jenkins / GitHub',
  'Xray / Testlink',
];

