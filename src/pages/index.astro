    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-10 md:mb-16 reveal">
        <div class="section-divider"></div>
        <span class="section-label">
          <span data-show-lang="de">ÜBER MICH</span><span data-show-lang="en" class="hidden">ABOUT ME</span>
        </span>
        <h2 class="text-3xl md:text-[2.6rem] font-bold leading-tight" data-key="about.title">Über mich</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">

        <!-- Text column -->
        <div class="reveal space-y-6">
          <p class="text-text-main/65 text-base sm:text-lg leading-[1.85]" data-key="about.para1">
            Eigentlich wollte ich Entwickler werden. In die IT bin ich über meine erste QA-Rolle gekommen und habe dort etwas gefunden, das ich nicht gesucht hatte: Ich schaue Software gern bis ins Detail an. Den Code schreibe ich in der Testautomatisierung.
          </p>
          <p class="text-text-main/65 text-base sm:text-lg leading-[1.85]" data-key="about.para2">
            Ich freue mich über einen kniffligen Edge Case, den andere übersehen hätten. Und ich höre nicht auf, bevor klar ist, warum etwas fehlschlägt. Danach soll das Team wissen, was zu tun ist, ohne dass ich noch eine Runde erklären muss.
          </p>
        </div>

        <!-- Visual column -->
        <div class="reveal flex justify-center">
          <div class="card-glow rounded-2xl p-6 md:p-8 bg-white/[0.02] w-full max-w-sm relative overflow-hidden">

            <!-- Background glow blobs -->
            <div class="absolute top-0 right-0 w-56 h-56 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(41,121,255,0.08), transparent 70%); transform: translate(30%, -30%);"></div>
            <div class="absolute bottom-0 left-0 w-40 h-40 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(0,229,170,0.07), transparent 70%); transform: translate(-30%, 30%);"></div>

            <!-- Geometric SVG -->
            <svg viewBox="0 0 200 200" width="160" height="160" class="mx-auto mb-6 md:mb-8 block w-full max-w-[180px]" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="about-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#2979FF"/>
                  <stop offset="100%" stop-color="#00E5AA"/>
                </linearGradient>
              </defs>

              <!-- Outer hexagon -->
              <polygon points="100,18 158,52 158,118 100,152 42,118 42,52" fill="none" stroke="url(#about-grad)" stroke-width="1.5" opacity="0.5"/>
              <!-- Inner hexagon -->
