  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Lirsch QA Consulting Ltd.",
    "description": "Freiberufliche Testanalyse und Testautomatisierung",
    "address": { "@type": "PostalAddress", "addressCountry": "CY" },
    "serviceType": ["Software Testing", "Test Automation", "QA Consulting"]
  }
  </script>

  <!-- Preload font hint -->
  <style>
    body { font-family: "Segoe UI", system-ui, sans-serif; }
  </style>
</head>

<body class="bg-bg text-text-main antialiased overflow-x-hidden">

  <!-- ======== NAVIGATION ======== -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 py-4">
    <div class="max-w-6xl mx-auto flex items-center justify-between">

      <!-- Wordmark -->
      <a href="#hero" class="text-sm font-semibold tracking-tight text-text-main leading-none">LQA</a>

      <!-- Nav links + lang switcher (desktop) -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#about" class="nav-link text-sm text-text-main/70 hover:text-green-accent transition-colors" data-key="nav.about">Über mich</a>
        <a href="#services" class="nav-link text-sm text-text-main/70 hover:text-green-accent transition-colors" data-key="nav.services">Leistungen</a>
        <a href="#projects" class="nav-link text-sm text-text-main/70 hover:text-green-accent transition-colors" data-key="nav.projects">Projekte</a>
        <a href="#stack" class="nav-link text-sm text-text-main/70 hover:text-green-accent transition-colors" data-key="nav.stack">Stack</a>
        <a href="#contact" class="nav-link text-sm text-text-main/70 hover:text-green-accent transition-colors" data-key="nav.contact">Kontakt</a>
        <!-- Talent Network temporarily disabled — re-enable by uncommenting and restoring src/pages/talent.astro from src/pages/_disabled/
        <a href="/talent" class="text-sm text-green-accent/70 hover:text-green-accent transition-colors">Talent Network</a>
        -->

        <!-- Language switcher -->
        <div class="flex items-center gap-1 border border-white/10 rounded-md px-1">
          <button id="btn-de" class="lang-btn active" onclick="setLang('de')">DE</button>
          <span class="text-white/20 text-xs">|</span>
          <button id="btn-en" class="lang-btn" onclick="setLang('en')">EN</button>
        </div>
      </div>

      <!-- Mobile menu button -->
      <button id="menu-btn" class="md:hidden text-text-main/70 hover:text-text-main" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-white/10">
      <div class="max-w-6xl mx-auto flex flex-col gap-4 pt-4 px-4">
        <a href="#about" class="nav-link text-sm text-text-main/70" data-key="nav.about" onclick="closeMobileMenu()">Über mich</a>
        <a href="#services" class="nav-link text-sm text-text-main/70" data-key="nav.services" onclick="closeMobileMenu()">Leistungen</a>
        <a href="#projects" class="nav-link text-sm text-text-main/70" data-key="nav.projects" onclick="closeMobileMenu()">Projekte</a>
        <a href="#stack" class="nav-link text-sm text-text-main/70" data-key="nav.stack" onclick="closeMobileMenu()">Stack</a>
        <a href="#contact" class="nav-link text-sm text-text-main/70" data-key="nav.contact" onclick="closeMobileMenu()">Kontakt</a>
        <!-- Talent Network temporarily disabled — see notice above
        <a href="/talent" class="text-sm text-green-accent/70" onclick="closeMobileMenu()">Talent Network</a>
        -->
        <div class="flex items-center gap-2">
          <button id="btn-de-m" class="lang-btn active" onclick="setLang('de')">DE</button>
          <span class="text-white/20 text-xs">|</span>
          <button id="btn-en-m" class="lang-btn" onclick="setLang('en')">EN</button>
        </div>
      </div>
    </div>
  </nav>

  <!-- ======== HERO ======== -->
  <section id="hero" class="relative min-h-[92vh] flex items-center px-4 sm:px-6 pt-28 pb-20">
    <div class="relative max-w-6xl mx-auto w-full grid md:grid-cols-[minmax(0,1.15fr)_minmax(16rem,22rem)] gap-14 md:gap-16 items-center">
      <div>
        <p class="hero-animate text-sm sm:text-base text-text-main/70 mb-5" style="animation-delay: 80ms;" data-key="hero.kicker">Qualität ist kein Zufall.</p>

        <h1 class="hero-animate text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-tight leading-[1.02]" style="animation-delay: 160ms;">
          Mario Lirsch
        </h1>
        <hr class="accent-line hero-animate" style="animation-delay: 240ms;" aria-hidden="true" />

        <p class="hero-animate text-base sm:text-lg md:text-xl text-text-main/85 max-w-xl mt-8 mb-10 leading-relaxed" style="animation-delay: 320ms;" data-key="hero.sub">
          Ich arbeite als freiberuflicher QA-Engineer in agilen Teams, remote und vor Ort, aktuell bei BRZ an der Zollanwendung Customs Decision Austria.
        </p>

        <div class="hero-animate" style="animation-delay: 440ms;">
          <a href="#contact" class="btn-cta" data-key="hero.cta">Schreiben Sie mir</a>
        </div>
      </div>

      <!-- Reserved for a portrait. Empty on purpose: no photo exists yet. -->
      <div class="photo-slot" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ======== ABOUT ======== -->
  <section id="about" class="py-24 md:py-36 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="section-title reveal" data-key="about.title">Über mich</h2>
      <div class="max-w-2xl space-y-8 reveal">
        <p class="text-lg md:text-xl leading-8 md:leading-9" data-key="about.para1">
          Eigentlich wollte ich Entwickler werden. In die IT bin ich über meine erste QA-Rolle gekommen und habe dort etwas gefunden, das ich nicht gesucht hatte: Ich schaue Software gern bis ins Detail an. Den Code schreibe ich in der Testautomatisierung.
        </p>
        <p class="text-lg md:text-xl leading-8 md:leading-9" data-key="about.para2">
          Ich freue mich über einen kniffligen Edge Case, den andere übersehen hätten. Und ich höre nicht auf, bevor klar ist, warum etwas fehlschlägt. Danach soll das Team wissen, was zu tun ist, ohne dass ich noch eine Runde erklären muss.
        </p>
        <p class="text-base leading-7 text-text-main/65 pt-4" data-key="about.note">
          ISTQB-zertifizierter Test Analyst, Foundation und Advanced. Ich arbeite remote und vor Ort.
        </p>
      </div>
    </div>
  </section>

  <!-- ======== SERVICES ======== -->
  <section id="services" class="py-24 md:py-36 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="section-title reveal" data-key="services.title">Leistungen</h2>
      <div class="service-grid">
        <div class="service-block reveal">
          <h3 data-key="services.card1.title">Testanalyse und Teststrategie</h3>
          <p data-key="services.card1.desc">
            So läuft es bei BRZ. Customs Decision Austria hängt an EU-Systemen, die Vorgaben ändern sich. Ich lese sie, lege den Testumfang fest und stimme die Testphasen mit dem Testmanager ab.
          </p>
          <a href="#project-brz" class="underline" data-key="services.card1.link">Das BRZ-Projekt</a>
        </div>
        <div class="service-block reveal">
          <h3 data-key="services.card2.title">Testautomatisierung</h3>
          <p data-key="services.card2.desc">
            So war es bei REWE. Die Artikelverwaltung wechselte von JSF auf Angular, und ich habe die Automatisierung mit Cypress und Cucumber neu aufgebaut: von null auf rund 200 Testfälle, neue Features jeweils gleich mit.
          </p>
          <a href="#project-rewe" class="underline" data-key="services.card2.link">Das REWE-Projekt</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== PROJECTS ======== -->
  <section id="projects" class="py-24 md:py-36 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="reveal">
        <h2 class="section-title" data-key="projects.title">Projekte</h2>
        <p class="text-lg text-text-main/75 mb-12 md:mb-16 max-w-xl" data-key="projects.sub">Zoll, Handel, Banken und ein Bauunternehmen.</p>
      </div>

      <ol class="timeline">
        {projects.map((project) => (
          <li id={project.id} class="timeline-item scroll-mt-28">
            <div class="timeline-when">
              <p class="timeline-year">{yearSpan(project.periodDe)}</p>
              <p class="timeline-period">
                <span data-show-lang="de">{project.periodDe}</span>
                <span data-show-lang="en" class="hidden">{project.periodEn}</span>
              </p>
            </div>
            <div class="timeline-body">
              <p class="timeline-industry">
                <span data-show-lang="de">{project.industryDe}</span>
                <span data-show-lang="en" class="hidden">{project.industryEn}</span>
              </p>
              <h3 class="timeline-company">{project.company}</h3>
              <p class="timeline-text">
                <span data-show-lang="de">{project.textDe}</span>
                <span data-show-lang="en" class="hidden">{project.textEn}</span>
              </p>
              <p class="timeline-tools">
                <span data-show-lang="de">{project.tagsDe.join(' · ')}</span>
                <span data-show-lang="en" class="hidden">{project.tagsEn.join(' · ')}</span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ======== TECH STACK ======== -->
  <section id="stack" class="py-24 md:py-36 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="reveal">
        <h2 class="section-title" data-key="stack.title">Tech Stack</h2>
        <p class="text-lg text-text-main/75 mb-8 max-w-xl" data-key="stack.sub">Womit ich arbeite.</p>
        <p class="stack-line">{techStack.join(' · ')}</p>
      </div>
    </div>
  </section>

  <!-- ======== CONTACT ======== -->
  <section id="contact" class="py-24 md:py-36 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="reveal max-w-xl">
        <h2 class="section-title" data-key="contact.title">Kontakt</h2>
        <p class="text-lg text-text-main/75 mb-12 leading-relaxed" data-key="contact.sub">Wenn Sie Unterstützung im Testen brauchen, schreiben Sie mir. Es reichen ein paar Sätze, worum es geht.</p>
      </div>

      <form
        action="mailto:mario@lqa-consulting.com"
        method="POST"
        enctype="text/plain"
        class="space-y-7 reveal max-w-xl"
      >
        <div>
          <label class="block text-sm text-text-main/70 mb-2" data-key="contact.name">Name</label>
          <input type="text" name="name" class="form-input" placeholder="Ihr Name" required data-placeholder-de="Ihr Name" data-placeholder-en="Your name" />
        </div>
        <div>
          <label class="block text-sm text-text-main/70 mb-2" data-key="contact.email">E-Mail</label>
          <input type="email" name="email" class="form-input" placeholder="max@example.com" required />
        </div>
        <div>
          <label class="block text-sm text-text-main/70 mb-2" data-key="contact.message">Nachricht</label>
          <textarea name="message" rows="5" class="form-input resize-none" placeholder="Worum geht es?" required data-placeholder-de="Worum geht es?" data-placeholder-en="What is it about?"></textarea>
        </div>
        <button type="submit" class="btn-cta" data-key="contact.send">Per E-Mail senden</button>
        <p class="text-sm text-text-main/55 leading-relaxed">
          <span data-show-lang="de">Der Button öffnet Ihr E-Mail-Programm, die Nachricht geht direkt an mich. Was ich mit den Angaben mache, steht in der <a href="/privacy" class="underline hover:text-text-main/80">Datenschutzerklärung</a>.</span>
          <span data-show-lang="en" class="hidden">The button opens your email app, and the message comes straight to me. How I handle what you send is in the <a href="/privacy" class="underline hover:text-text-main/80">privacy policy</a>.</span>
        </p>
      </form>

      <div class="flex flex-col sm:flex-row items-start gap-6 mt-14 reveal">
        <a
